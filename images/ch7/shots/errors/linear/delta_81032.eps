%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48 480.00004 0] CT
[1 0 0 1 0 0] CT
N
-1000 0 M
500 0 L
500 1000 L
-1000 1000 L
-1000 0 L
cp
clip
GS
0 0 translate
500 333 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 333
  /ImageMatrix [500 0 0 333 0 0]
  /Width 500
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
