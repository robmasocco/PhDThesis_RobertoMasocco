{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 667
  /ImageMatrix [500 0 0 667 0 0]
  /Width 500
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
